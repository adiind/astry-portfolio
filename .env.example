# WorkOS application client ID (WorkOS dashboard > API keys).
WORKOS_CLIENT_ID=
# Where AuthKit sends users after sign-in, e.g. http://localhost:3300/callback (must match the dashboard).
NEXT_PUBLIC_WORKOS_REDIRECT_URI=
# Random secret, 32+ characters, that encrypts the session cookie (openssl rand -base64 24).
WORKOS_COOKIE_PASSWORD=
# WorkOS secret API key (optional; app runs keyless without it).
WORKOS_API_KEY=
